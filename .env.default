EVENTBRITE_API_key=""
EVENTBRITE_Client_secret=""
EVENTBRITE_Private_token=""
EVENTBRITE_Public_token="" 

# --- Email campaigns (promoteEvent.js) ---------------------------------------
# The campaign API (https://www.eventbrite.be/api/v3/missive/...) is private and takes
# cookie-session auth only - the private token above does NOT work on it.
# DevTools > Network > any /api/v3/ request > Request Headers > Cookie > Copy value.
# Keep it on one line and single-quote it (the value contains " { } %).
EVENTBRITE_WEB_COOKIE=''
# Optional. Normally derived from the csrftoken entry of the cookie above; set this only
# if the cookie you pasted has no csrftoken.
EVENTBRITE_WEB_CSRF_TOKEN=''
# Optional. Asserted against the organization returned by the private token.
EVENTBRITE_ORGANIZATION_ID=''
